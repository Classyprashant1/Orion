# ==============================================================================
# ORION - Voice-Controlled Desktop Virtual Assistant Configuration
# Copy this file to `.env` and fill in any optional keys you want to enable.
# ORION works out of the box with ZERO API keys required for all core features.
# ==============================================================================

# Companion Web Control Center / REST API settings
ORION_API_HOST=127.0.0.1
ORION_API_PORT=8765
ORION_AUTO_START_API=true

# Database and Screenshot Storage (defaults to ./data/orion.db and ./screenshots)
ORION_DB_PATH=data/orion.db
ORION_SCREENSHOT_DIR=screenshots

# Speech Recognition defaults
ORION_STT_LANGUAGE=en-IN
ORION_WAKE_WORD=orion

# Optional: OpenWeatherMap API key for live weather queries ("what is the weather in Delhi")
# Free key available at: https://openweathermap.org/api
# If omitted, ORION falls back to wttr.in public weather endpoint when online.
OPENWEATHER_API_KEY=
ORION_DEFAULT_CITY=Delhi

# Optional: AI Language Model Integration (Future Scope hook - disabled unless key is set)
# Supported providers: "gemini", "openai", "none"
ORION_AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
